# Duración máxima permitida de vídeos de YouTube, en segundos
MAX_VIDEO_SECONDS=900

# ==========================================
#  DEPURACIÓN
# ==========================================
LOG_LEVEL=info
LOG_JSON=false
SHOW_QR=false